{
  "name": "renoir",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Renoir — local-first AI design studio. Bring your own LLM. Image gen via Azure Foundry.",
  "author": "Pourab Karchaudhuri",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "npm run electron:dev",
    "build": "npm run clean && tsc -p tsconfig.node.json && cpx \"electron/preload.cjs\" dist-electron/electron && vite build && electron-builder",
    "build:app": "npm run clean && tsc && tsc -p tsconfig.node.json && cpx \"electron/preload.cjs\" dist-electron/electron && vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.node.json && cpx \"electron/preload.cjs\" dist-electron/electron",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:local": "npm run build:app && electron-builder --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.14.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.renoir.app",
    "productName": "Renoir",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/preload.cjs"
    ],
    "extraFiles": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "skills",
        "to": "skills"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.svg",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Renoir"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
