# ─── Renoir ────────────────────────────────────────────────────────────────
# BYOK is for the LLM only. You can configure it via the Settings UI (stored
# in OS keychain), OR set these env vars for dev convenience — they act as
# defaults when nothing is configured via UI.
#
# BYOK_BASE_URL=https://api.openai.com/v1
# BYOK_MODEL=gpt-4o
# BYOK_API_KEY=sk-...
#
# Image generation uses Azure Foundry deployments, configured below.
# Copy this file to .env (it is loaded by Electron main on startup).

# Azure Foundry resource endpoint (no trailing slash).
# e.g. https://my-foundry.cognitiveservices.azure.com
AZURE_FOUNDRY_ENDPOINT=

# Azure Foundry API key (resource-level). Renoir never exposes this to the renderer.
AZURE_FOUNDRY_API_KEY=<your-azure-foundry-api-key>

# API version used by image-generation route. Override only if your
# deployment requires a different one.
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview

# Deployment names. Two pre-wired:
#   - gpt-image-2  →  image generation
#   - gpt-5.4      →  text/LLM (optional fallback if no BYOK is set)
AZURE_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_TEXT_DEPLOYMENT=gpt-5.4

# Optional — enables the Audio and Video bays in the Media view.
# Leave blank to keep the bays disabled with a friendly note.
# AZURE_AUDIO_DEPLOYMENT=
# AZURE_VIDEO_DEPLOYMENT=
AZURE_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_TEXT_DEPLOYMENT=gpt-5.4
